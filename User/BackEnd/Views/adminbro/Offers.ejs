<!-- testing sync -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Offers</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#f8f8f4] text-gray-800">

<!-- HEADER -->
<header class="bg-[#eff2c8] px-10 py-5 flex items-center justify-between">
  <div class="flex items-center gap-10">
    <h1 class="font-bold text-lg">Pitchwear</h1>
    <p class="text-sm font-semibold">Admin Dashboard</p>
  </div>

</header>

<main class="flex px-10 py-10 gap-10">

<!-- SIDEBAR -->
  <%- include("partials/sidebar") %>

<!-- CONTENT -->
<section class="flex-1">

<h2 class="text-3xl font-bold mb-6">
Offer Management
</h2>


<!-- CREATE OFFER -->
<div class="bg-white border rounded-xl p-6 mb-8">

<h3 class="font-semibold mb-4">Create Offer</h3>

<form action="/admin/offers" method="POST" class="grid grid-cols-2 gap-4">

<input
name="name"
placeholder="Offer Name"
required
class="border px-3 py-2 rounded"
/>

<input
name="discountPercent"
type="number"
placeholder="Discount %"
min="1"
max="90"
required
class="border px-3 py-2 rounded"
/>

<select
name="type"
class="border px-3 py-2 rounded">

<option value="Product">
Product Offer
</option>

<option value="Team">
Team Offer
</option>

</select>

<input
type="date"
name="expiryDate"
required
class="border px-3 py-2 rounded"
/>

<select name="product" class="border px-3 py-2 rounded">

<option value="">
Select Product
</option>

<% products.forEach(product => { %>

<option value="<%= product._id %>">
<%= product.name %>
</option>

<% }) %>

</select>


<select name="team" class="border px-3 py-2 rounded" disabled>

<option value="">
Select Team
</option>

<% teams.forEach(team => { %>

<option value="<%= team._id %>">
<%= team.name %>
</option>

<% }) %>

</select>


<button
class="col-span-2 bg-[#cdd47b] py-2 rounded-lg font-semibold">
Create Offer
</button>

</form>

</div>



<!-- OFFERS TABLE -->

<div class="bg-white border rounded-xl overflow-hidden">

<table class="w-full text-sm">

<thead class="bg-gray-50 text-gray-500">

<tr>

<th class="text-left px-6 py-4">
Offer Name
</th>

<th class="text-left px-6 py-4">
Type
</th>

<th class="text-left px-6 py-4">
Discount
</th>

<th class="text-left px-6 py-4">
Product / Team
</th>

<th class="text-left px-6 py-4">
Expiry
</th>

<th class="text-center px-6 py-4">
Action
</th>

</tr>

</thead>

<tbody>


<% if(!offers || offers.length === 0){ %>

<tr>

<td colspan="6" class="text-center py-16 text-gray-400">
No offers found
</td>

</tr>

<% } %>



<% offers.forEach(offer => { %>

<tr class="border-t">

<td class="px-6 py-4">
<%= offer.name %>
</td>

<td class="px-6 py-4">
<%= offer.type %>
</td>

<td class="px-6 py-4">
<%= offer.discountPercent %>%
</td>

<td class="px-6 py-4">

<% if (offer.product?.name) { %>
  Product: <%= offer.product.name %>

<% } else if (offer.team?.name) { %>
  Team: <%= offer.team.name %>

<% } else { %>
  No Target

<% } %>

</td>

<td class="px-6 py-4">

<%= offer.expiryDate ? new Date(offer.expiryDate).toDateString() : "No Expiry" %>

</td>

<td class="px-6 py-4 text-center">

  <button onclick="openEditModal(
 '<%= offer._id %>',
 '<%= offer.name %>',
 '<%= offer.discountPercent %>',
 '<%= offer.type %>',
 '<%= offer.product?._id || "" %>',
 '<%= offer.team?._id || "" %>',
 '<%= offer.expiryDate ? offer.expiryDate.toISOString().split("T")[0] : "" %>'
)" class="text-blue-600 font-medium">
Edittt
</button>


<form
action="/admin/offers/<%= offer._id %>?_method=DELETE"
method="POST">


<button 
  type="button"
  onclick="openDeleteModal('<%= offer._id %>')"
  class="text-red-600 font-medium">
  Delete
</button>

</form>

</td>

</tr>

<% }) %>


</tbody>

</table>

</div> 

</section>

</main>

<% if(error){ %>

<div id="errorModal"
class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50">

<div class="bg-white p-6 rounded-xl w-[350px] text-center">

<h3 class="text-red-600 font-semibold mb-3">
Error
</h3>

<p class="text-sm mb-5">
<%= error %>
</p>

<button onclick="closeModal()"
class="bg-red-500 text-white px-4 py-2 rounded">
OK
</button>

</div>

</div>

<script>

function closeModal(){
 document.getElementById("errorModal").remove();
}

</script>

<% } %>



<div id="validationModal"
class="fixed inset-0 bg-black bg-opacity-40 hidden items-center justify-center z-50">

<div class="bg-white p-6 rounded-xl w-[350px] text-center">

<h3 class="text-red-600 font-semibold mb-3">
Validation Error
</h3>

<p id="validationMessage" class="text-sm mb-5"></p>

<button onclick="closeValidationModal()"
class="bg-red-500 text-white px-4 py-2 rounded">
OK
</button>

</div>

</div>


<!-- modal -->

<div id="editModal"
class="fixed inset-0 bg-black bg-opacity-40 hidden items-center justify-center z-50">

<div class="bg-white p-6 rounded-xl w-[400px]">

<h3 class="font-semibold text-lg mb-4">Edit Offer</h3>

<form id="editForm" method="POST">

<input type="hidden" name="_method" value="PUT" />

<!-- Offer Name --> 
<div class="mb-3">
  <label class="text-sm font-medium text-gray-700">Offer Name</label>
  <input name="name" id="editName"
    class="border p-2 w-full rounded mt-1" />
</div>

<!-- Discount -->
<div class="mb-3">
  <label class="text-sm font-medium text-gray-700">Discount %</label>
  <input name="discountPercent" id="editDiscount" type="number"
    class="border p-2 w-full rounded mt-1" />
</div>

<!-- Type -->
<div class="mb-3">
  <label class="text-sm font-medium text-gray-700">Type</label>
  <select name="type" id="editType"
    class="border p-2 w-full rounded mt-1">
    <option value="Product">Product</option>
    <option value="Team">Team</option>
  </select>
</div>

<!-- Expiry Date -->
<div class="mb-3">
  <label class="text-sm font-medium text-gray-700">Expiry Date</label>
  <input type="date" name="expiryDate" id="editExpiry"
    class="border p-2 w-full rounded mt-1" />
</div>

<!-- Product -->
<div class="mb-3">
  <label class="text-sm font-medium text-gray-700">Product</label>
  <select name="product" id="editProduct"
    class="border p-2 w-full rounded mt-1">
    <option value="">Select Product</option>
    <% products.forEach(product => { %>
      <option value="<%= product._id %>"><%= product.name %></option>
    <% }) %>
  </select>
</div>

<!-- Team -->
<div class="mb-4">
  <label class="text-sm font-medium text-gray-700">Team</label>
  <select name="team" id="editTeam"
    class="border p-2 w-full rounded mt-1">
    <option value="">Select Team</option>
    <% teams.forEach(team => { %>
      <option value="<%= team._id %>"><%= team.name %></option>
    <% }) %>
  </select>
</div>

<!-- Button -->
<button class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded w-full font-medium">
  Update
</button>

</form>

</div>
</div>


<!-- delete modal -->


<div id="deleteModal"  
class="fixed inset-0 bg-black bg-opacity-40 hidden items-center justify-center z-50">

<div class="bg-white p-6 rounded-xl w-[350px] text-center">

<h3 class="text-lg font-semibold mb-3">Confirm Delete</h3>

<p class="text-sm text-gray-600 mb-5">
Are you sure you want to delete this offer? This action cannot be undone.
</p>

<form id="deleteForm" method="POST">
  <input type="hidden" name="_method" value="DELETE" />

  <div class="flex justify-center gap-3">
    <button type="button"
      onclick="closeDeleteModal()"
      class="px-4 py-2 border rounded">
      Cancel
    </button>

    <button class="px-4 py-2 bg-red-500 text-white rounded">
      Delete
    </button>
  </div>
</form>

</div>
</div>



<script>

function showValidationModal(message){

const modal = document.getElementById("validationModal")
const messageBox = document.getElementById("validationMessage")

messageBox.innerText = message

modal.classList.remove("hidden")
modal.classList.add("flex")

}

function closeValidationModal(){

const modal = document.getElementById("validationModal")

modal.classList.add("hidden")
modal.classList.remove("flex")

}

</script>



<script>

const form = document.querySelector("form")

const typeSelect = document.querySelector('[name="type"]')
const productSelect = document.querySelector('[name="product"]')
const teamSelect = document.querySelector('[name="team"]')

typeSelect.addEventListener("change",()=>{

 if(typeSelect.value === "Product"){
  productSelect.disabled = false
  teamSelect.disabled = true
 }

 else{
  productSelect.disabled = true
  teamSelect.disabled = false
 }

})


form.addEventListener("submit",(e)=>{

const type = typeSelect.value
const product = productSelect.value
const team = teamSelect.value

if(type === "Product" && !product){
 e.preventDefault()
 return showValidationModal("Please select a product for Product Offer")
}

if(type === "Team" && !team){
 e.preventDefault()
 return showValidationModal("Please select a team for Team Offer")
}

})

</script>


<script>

function openEditModal(id, name, discount, type, product, team, expiry){

 const modal = document.getElementById("editModal");

 document.getElementById("editForm").action = `/admin/offers/${id}?_method=PUT`;

 document.getElementById("editName").value = name;
 document.getElementById("editDiscount").value = discount;
 document.getElementById("editType").value = type;
 document.getElementById("editExpiry").value = expiry;

 document.getElementById("editProduct").value = product;
 document.getElementById("editTeam").value = team;

 toggleEditFields(type);

 modal.classList.remove("hidden");
 modal.classList.add("flex");
}

function toggleEditFields(type){
 const product = document.getElementById("editProduct");
 const team = document.getElementById("editTeam");

 if(type === "Product"){
  product.disabled = false;
  team.disabled = true;
 } else {
  product.disabled = true;
  team.disabled = false;
 }
}

document.getElementById("editType").addEventListener("change", (e)=>{
 toggleEditFields(e.target.value);
});

</script>


<script>  

function openDeleteModal(id){
  const modal = document.getElementById("deleteModal");
  const form = document.getElementById("deleteForm");   

  form.action = `/admin/offers/${id}?_method=DELETE`;

  modal.classList.remove("hidden");
  modal.classList.add("flex");
}

function closeDeleteModal(){
  const modal = document.getElementById("deleteModal");

  modal.classList.add("hidden");
  modal.classList.remove("flex");
}

</script>

</body>

</html>