<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Verify Password | PitchWear</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#7da77b',
            bgLight: '#faf9f6'
          }
        }
      }
    }
  </script>
</head>

<body class="bg-bgLight min-h-screen flex items-center justify-center">

  <div class="bg-white w-full max-w-md rounded-2xl shadow-sm p-10">

    <!-- Heading -->
    <h1 class="text-2xl font-semibold text-gray-800 mb-2">
      Verify Password
    </h1>

    <p class="text-sm text-gray-500 mb-8">
      Please enter your current password to continue.
    </p>

    <!-- Error Message -->
    <% if (error) { %>
      <div class="mb-5 bg-red-100 text-red-600 text-sm px-4 py-3 rounded-lg">
        <%= error %>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/profile/verify-password" method="POST" class="space-y-6">

      <!-- Current Password -->
      <div>
        <label class="block text-sm font-medium mb-2 text-gray-700">
          Current Password
        </label>

        <div class="relative">
          <input
            type="password"
            id="oldPassword"
            name="oldPassword"
            required
            placeholder="Enter current password"
            class="w-full border rounded-lg px-4 py-3 pr-12 focus:outline-none focus:ring-2 focus:ring-primary"
          />

          <button
            type="button"
            onclick="togglePassword()"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-gray-500"
          >
            Show
          </button>
        </div>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        class="w-full bg-primary text-white py-3 rounded-lg font-medium hover:opacity-90 transition"
      >
        Continue
      </button>

    </form>

    <!-- Back -->
    <div class="mt-6 text-center">
      <a
        href="/profile"
        class="text-sm text-gray-500 hover:text-black"
      >
        ← Back to Profile
      </a>
    </div>

  </div>

  <script>
    function togglePassword() {

      const input =
        document.getElementById("oldPassword");

      if (input.type === "password") {
        input.type = "text";
      } else {
        input.type = "password";
      }
    }
  </script>

</body>
</html>